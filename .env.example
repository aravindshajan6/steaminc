# Copy to .env and fill in. Without a key the app runs in DEMO MODE on bundled sample data.
#
# Get a free key at https://www.themoviedb.org/settings/api
# Either works — v3 key OR v4 read access token (the long "eyJ..." string).
TMDB_API_KEY=

# Optional. Server port.
PORT=5173

# Optional. Default watch-provider region (ISO 3166-1 alpha-2).
DEFAULT_REGION=US
