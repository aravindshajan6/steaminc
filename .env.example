# Copy to .env and fill in. Everything here is optional — with none of it set the app
# still boots, serves the free Internet Archive row, and stores accounts in a file.

# --- Catalog -----------------------------------------------------------------
# Free key from https://www.themoviedb.org/settings/api
# Either works: a v3 API key OR a v4 read access token (the long "eyJ..." string).
# Without it the catalog rows fall back to bundled placeholder titles.
TMDB_API_KEY=

# --- Storage -----------------------------------------------------------------
# Leave MONGODB_URI empty to keep accounts in a JSON file under DATA_DIR. That is
# the right default locally and on any host with a real disk.
#
# Set it when the filesystem is NOT durable — Render's free plan has no persistent
# disk, so a file store there is wiped on every restart and deploy — or when more
# than one instance has to share accounts.
#
#   Atlas:       mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   Local compose: mongodb://mongo:27017   (with `docker compose --profile mongo up`)
MONGODB_URI=
MONGODB_DB=steaminc

# --- Misc --------------------------------------------------------------------
# Port. Hosts like Render inject their own; this is the local fallback.
PORT=5173

# Default watch-provider region (ISO 3166-1 alpha-2).
DEFAULT_REGION=US
